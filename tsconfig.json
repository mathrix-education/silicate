{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "target": "es2018",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "@mathrix-education/silicate-core": [
        "dist/silicate-core"
      ],
      "@mathrix-education/silicate-core/*": [
        "dist/silicate-core/*"
      ],
      "@mathrix-education/silicate-education": [
        "dist/silicate-education"
      ],
      "@mathrix-education/silicate-education/*": [
        "dist/silicate-education/*"
      ],
      "@mathrix-education/silicate-essentials": [
        "dist/silicate-essentials"
      ],
      "@mathrix-education/silicate-essentials/*": [
        "dist/silicate-essentials/*"
      ],
      "@mathrix-education/silicate-latex": [
        "dist/silicate-latex"
      ],
      "@mathrix-education/silicate-latex/*": [
        "dist/silicate-latex/*"
      ],
      "@mathrix-education/silicate-videos": [
        "dist/silicate-videos"
      ],
      "@mathrix-education/silicate-videos/*": [
        "dist/silicate-videos/*"
      ]
    }
  }
}
