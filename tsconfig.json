{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "target": "es2015",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "silicate-core": [
        "dist/silicate-core"
      ],
      "silicate-core/*": [
        "dist/silicate/*"
      ],
      "silicate-video": [
        "dist/silicate-video"
      ],
      "silicate-video/*": [
        "dist/silicate-video/*"
      ]
    }
  }
}